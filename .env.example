# ==============================================================================
# FlashVeditor - Konfigurasi Kunci API & Model Gateway
# Lokasi file aktif: ~/.config/creator-teardown/.env atau $AI_EDITOR_HOME/.env
# ==============================================================================

# OPSI A: Google AI Studio Resmi (Direct)
# Dapatkan key di https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSy...

# OPSI B: Gateway Lokal 9Router / Model AI Pilihan
# Kompatibel dengan model Gemini Native, Claude Opus, Gemini Flash High
GEMINI_BASE_URL=http://127.0.0.1:20128
GEMINI_API_VERSION=v1beta
GEMINI_AUTH_MODE=bearer
GEMINI_MODEL=ag/gemini-3.8-flash-high
GEMINI_FRAME_SAMPLING=1
GEMINI_API_KEY=

# OPSI C: ElevenLabs Scribe Transkripsi (Opsional)
# Tanpa ini, sistem otomatis menggunakan faster-whisper lokal (gratis)
# ELEVENLABS_API_KEY=
